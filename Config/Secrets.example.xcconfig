// Telegram API credentials — obtain from https://my.telegram.org (API development tools).
//
// Setup:
//   1. cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//   2. Fill in the real values below in your (gitignored) Secrets.xcconfig
//   3. Re-run `xcodegen generate` if you changed project.yml
//
// These are read into Info.plist (TelegramApiId / TelegramApiHash) and consumed
// by AppConfig at runtime.

TELEGRAM_API_ID = 0
TELEGRAM_API_HASH = your_api_hash_here
